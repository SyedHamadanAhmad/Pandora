# PostgreSQL
POSTGRES_USER=pandora
POSTGRES_PASSWORD=pandora
POSTGRES_DB=pandora
DATABASE_URL=postgresql+asyncpg://pandora:pandora@postgres:5432/pandora

# RabbitMQ
RABBITMQ_DEFAULT_USER=pandora
RABBITMQ_DEFAULT_PASS=pandora
RABBITMQ_URL=amqp://pandora:pandora@rabbitmq:5672/

# MinIO (S3-compatible)
MINIO_ACCESS_KEY=pandora
MINIO_SECRET_KEY=pandora-secret
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=pandora-images

# Backend
SECRET_KEY=change-me-to-a-random-string-in-production

# LLM (required for worker phases)
DEEPSEEK_API_KEY=
# Optional override (default https://api.deepseek.com)
# DEEPSEEK_BASE_URL=
