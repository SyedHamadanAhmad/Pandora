FROM python:3.11-slim

WORKDIR /app

# Playwright/Chromium runtime libraries on Debian bookworm (python:3.11-slim).
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc nodejs npm curl \
    libnss3 libnspr4 libdbus-1-3 \
    libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
    libpango-1.0-0 libcairo2 libasound2 \
    fonts-liberation fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

COPY pandora_shared /app/pandora_shared
RUN pip install --no-cache-dir -e /app/pandora_shared

COPY workers/requirements.base.txt workers/requirements.crawl.txt ./
RUN pip install --no-cache-dir -r requirements.crawl.txt
RUN playwright install chromium

COPY workers/src/ ./src/

ENV PYTHONPATH=/app/src

CMD ["python", "-m", "pandora_workers.run.parse_url"]
